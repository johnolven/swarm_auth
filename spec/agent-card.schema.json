{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swarmid.io/schemas/agent-card.schema.json",
  "title": "AgentCard",
  "description": "Public identity card for an AI agent registered in the SwarmID network. Contains the agent's profile, owner trust info, endpoints, and authentication details.",
  "type": "object",
  "required": ["swarmid", "agent", "owner", "auth"],
  "additionalProperties": false,
  "properties": {
    "swarmid": {
      "type": "string",
      "description": "SwarmID specification version.",
      "enum": ["1.0"]
    },
    "agent": {
      "type": "object",
      "description": "The agent's public profile information.",
      "required": ["id", "slug", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for the agent (UUID v4)."
        },
        "slug": {
          "type": "string",
          "description": "URL-safe, lowercase identifier for the agent. Must be 3-40 characters, alphanumeric and hyphens only, starting and ending with an alphanumeric character.",
          "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$",
          "minLength": 3,
          "maxLength": 40
        },
        "name": {
          "type": "string",
          "description": "Human-readable display name for the agent.",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Short description of what the agent does.",
          "maxLength": 500
        },
        "avatar": {
          "type": "string",
          "format": "uri",
          "description": "URL to the agent's avatar image."
        },
        "capabilities": {
          "type": "array",
          "description": "List of capability tags describing what the agent can do.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        },
        "skills": {
          "type": "array",
          "description": "Skills the agent has installed, referencing ClawHub skill slugs.",
          "items": {
            "type": "object",
            "required": ["name", "source"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name of the skill.",
                "minLength": 1,
                "maxLength": 100
              },
              "description": {
                "type": "string",
                "description": "Short description of the skill.",
                "maxLength": 300
              },
              "source": {
                "type": "string",
                "description": "ClawHub skill reference in the format clawhub:<skill-slug>.",
                "pattern": "^clawhub:[a-z0-9][a-z0-9-]*[a-z0-9]$"
              }
            }
          },
          "minItems": 0,
          "maxItems": 50
        },
        "protocols": {
          "type": "array",
          "description": "Communication protocols the agent supports.",
          "items": {
            "type": "string",
            "enum": ["MCP", "A2A", "HTTP"]
          },
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the agent was created."
        }
      }
    },
    "owner": {
      "type": "object",
      "description": "Information about the agent's owner. The email is stored as a SHA-256 hash for privacy.",
      "required": ["email_hash", "trust_level"],
      "additionalProperties": false,
      "properties": {
        "email_hash": {
          "type": "string",
          "description": "SHA-256 hex digest of the owner's email address.",
          "pattern": "^[a-f0-9]{64}$"
        },
        "verified": {
          "type": "boolean",
          "description": "Whether the owner's email has been verified.",
          "default": false
        },
        "trust_level": {
          "type": "string",
          "description": "The trust tier assigned to this agent's owner.",
          "enum": ["unverified", "verified", "enterprise"]
        }
      }
    },
    "endpoints": {
      "type": "object",
      "description": "Public endpoints for interacting with the agent.",
      "additionalProperties": false,
      "properties": {
        "card": {
          "type": "string",
          "format": "uri",
          "description": "URL where this AgentCard can be fetched."
        },
        "agent_email": {
          "type": "string",
          "description": "The agent's SwarmID email alias in the format slug@swarmid.io.",
          "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]@swarmid\\.io$",
          "format": "email"
        }
      }
    },
    "auth": {
      "type": "object",
      "description": "Authentication configuration for the agent.",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "description": "The authentication scheme used by this agent.",
          "enum": ["bearer", "api-key", "oauth2"]
        },
        "registration_endpoint": {
          "type": "string",
          "format": "uri",
          "description": "URL where new agents can register for credentials."
        }
      }
    }
  }
}
